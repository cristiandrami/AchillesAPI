  "components": {
    "schemas": {
      "Asset": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "owner": {
            "type": "string",
            "title": "Owner"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "internal_note": {
            "type": "string",
            "title": "Internal Note",
            "default": "confidential-demo",
            "writeOnly": true
          },
          "is_approved": {
            "type": "boolean",
            "title": "Is Approved",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "owner",
          "label"
        ],
        "title": "Asset"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewAsset": {
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 60,
            "minLength": 3,
            "title": "Label",
            "examples": [
              "temporary-test-asset"
            ]
          },
          "owner": {
            "type": "string",
            "title": "Owner",
            "examples": [
              "alice"
            ]
          }
        },
        "type": "object",
        "required": [
          "label",
          "owner"
        ],
        "title": "NewAsset"
      },
      "PatchAsset": {
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "is_approved": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Approved"
          }
        },
        "type": "object",
        "title": "PatchAsset"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}