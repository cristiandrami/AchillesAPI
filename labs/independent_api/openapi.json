        ],
        "summary": "Search",
        "operationId": "search_v2_search_get",
        "parameters": [
          {
            "name": "term",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "title": "Term"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
