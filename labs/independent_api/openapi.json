    "/v2/inventory": {
      "post": {
        "tags": [
          "inventory"
        ],
        "summary": "Create Asset",
        "operationId": "create_asset_v2_inventory_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
