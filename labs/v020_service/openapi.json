{
  "openapi": "3.1.0",
  "info": {
    "title": "Unrelated Contractor Platform",
    "description": "Local verification target, independent from AchillesAPI core.",
    "version": "2026.1"
  },
  "paths": {
    "/oauth/token": {
      "post": {
        "summary": "Oauth Token",
        "description": "Mock OAuth2 client-credentials endpoint (uses demo-only Basic credentials).",
        "operationId": "oauth_token_oauth_token_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/session": {
      "post": {
        "summary": "Session",
        "description": "JSON-login example returning a nested token pointer.",
        "operationId": "session_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/organizations": {
      "get": {
        "summary": "Organizations",
        "description": "Produce a nonstandard identifier name for the next GET.",
        "operationId": "organizations_api_organizations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Listing"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/organizations/{organization_ref}": {
      "get": {
        "summary": "Organization",
        "description": "Read an object after obtaining its ID from a previous response.",
        "operationId": "organization_api_organizations__organization_ref__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "organization_ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Organization Ref"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Org"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/organizations/{organization_ref}/settings": {
      "get": {
        "summary": "Settings",
        "description": "Deliberately return a documented writeOnly field: disclosure test.",
        "operationId": "settings_api_organizations__organization_ref__settings_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "organization_ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Organization Ref"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/failure": {
      "get": {
        "summary": "Failure",
        "description": "Stable 503 used to test bounded adaptive verification, not an exploit.",
        "operationId": "failure_api_failure_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Return service readiness without credentials.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Listing": {
        "properties": {
          "organizations": {
            "items": {
              "$ref": "#/components/schemas/Org"
            },
            "type": "array",
            "title": "Organizations"
          }
        },
        "type": "object",
        "required": [
          "organizations"
        ],
        "title": "Listing"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "Org": {
        "properties": {
          "organization_ref": {
            "type": "string",
            "title": "Organization Ref"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "organization_ref",
          "display_name"
        ],
        "title": "Org"
      },
      "Settings": {
        "properties": {
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "private_key": {
            "type": "string",
            "title": "Private Key",
            "writeOnly": true
          }
        },
        "type": "object",
        "required": [
          "mode",
          "private_key"
        ],
        "title": "Settings"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
