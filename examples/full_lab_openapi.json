    "/api/search": {
      "get": {
        "tags": [
          "06 - SQLi signal vulnerable"
        ],
        "summary": "Search Vulnerable",
        "description": "SIMULATED SQL error disclosure triggered by a quote canary.\n\nThere is NO actual SQL database or injectable query. This endpoint safely\nreproduces the *observable signal* detected by the legacy sqli-check.",
        "operationId": "search_vulnerable_api_search_get",
        "security": [
